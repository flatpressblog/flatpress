<?php
/**
 * Regression validation for Sitemap Protocol 0.9 + image sitemap output.
 *
 * The test is repository-independent: it copies the FlatPress source tree to
 * a temporary directory, deliberately excludes every source fp-content file,
 * creates a minimal fixture installation with neutral entries/images, and
 * executes the real sitemap.php there.
 *
 * No XML extension is required.
 *
 * Usage:
 *   php validate_sitemap_images.php
 */

error_reporting(E_ALL);

$sourceRoot = realpath(__DIR__ . '/../../../');
if ($sourceRoot === false) {
	fwrite(STDERR, "Cannot resolve FlatPress root.\n");
	exit(2);
}
$sourceRoot = rtrim(str_replace('\\', '/', $sourceRoot), '/') . '/';

$fixtureBase = sys_get_temp_dir() . '/flatpress-sitemap-regression-' . getmypid() . '-' . uniqid('', true);
$fixtureBase = str_replace('\\', '/', $fixtureBase);
$fixtureRoot = $fixtureBase . '/flatpress/';

/**
 * Remove a temporary fixture tree.
 *
 * @param string $path
 * @return void
 */
function sitemap_regression_remove_tree($path) {
	if (!file_exists($path) && !is_link($path)) {
		return;
	}
	if (is_link($path) || !is_dir($path)) {
		@unlink($path);
		return;
	}
	$items = scandir($path);
	if (is_array($items)) {
		foreach ($items as $item) {
			if ($item === '.' || $item === '..') {
				continue;
			}
			sitemap_regression_remove_tree($path . '/' . $item);
		}
	}
	@rmdir($path);
}

/**
 * Copy the repository source tree while deliberately excluding instance data.
 *
 * The top-level fp-content directory is never copied. This is the key
 * regression invariant: the sitemap test must not depend on entries, images,
 * caches, users or configuration from an installed developer instance.
 *
 * @param string $source
 * @param string $target
 * @param string $relative
 * @return bool
 */
function sitemap_regression_copy_source_tree($source, $target, $relative = '') {
	if (!is_dir($target) && !mkdir($target, 0777, true) && !is_dir($target)) {
		return false;
	}

	$items = scandir($source);
	if (!is_array($items)) {
		return false;
	}

	foreach ($items as $item) {
		if ($item === '.' || $item === '..') {
			continue;
		}

		$childRelative = $relative === '' ? $item : $relative . '/' . $item;
		if ($childRelative === 'fp-content' || $childRelative === '.git') {
			continue;
		}

		$from = $source . '/' . $item;
		$to = $target . '/' . $item;

		if (is_link($from)) {
			// FlatPress distributions do not require symlinks. Skipping them
			// avoids following developer-local links into unrelated data.
			continue;
		}

		if (is_dir($from)) {
			if (!sitemap_regression_copy_source_tree($from, $to, $childRelative)) {
				return false;
			}
		} elseif (is_file($from)) {
			$parent = dirname($to);
			if (!is_dir($parent) && !mkdir($parent, 0777, true) && !is_dir($parent)) {
				return false;
			}
			if (!copy($from, $to)) {
				return false;
			}
		}
	}

	return true;
}

/**
 * Write a fixture file, creating parent directories as needed.
 *
 * @param string $path
 * @param string $contents
 * @return bool
 */
function sitemap_regression_write_file($path, $contents) {
	$parent = dirname($path);
	if (!is_dir($parent) && !mkdir($parent, 0777, true) && !is_dir($parent)) {
		return false;
	}
	return file_put_contents($path, $contents) !== false;
}

/**
 * Run one PHP child process.
 *
 * @param string $script
 * @param string $cwd
 * @param array<int,string> $args
 * @return array{exit:int,stdout:string,stderr:string}
 */
function sitemap_regression_run_php($script, $cwd, $args = array()) {
	$descriptors = array(
		0 => array('pipe', 'r'),
		1 => array('pipe', 'w'),
		2 => array('pipe', 'w')
	);

	$command = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($script);
	foreach ($args as $arg) {
		$command .= ' ' . escapeshellarg((string)$arg);
	}

	$process = proc_open($command, $descriptors, $pipes, $cwd);
	if (!is_resource($process)) {
		return array(
			'exit' => 2,
			'stdout' => '',
			'stderr' => 'Cannot start PHP child process.'
		);
	}

	fclose($pipes [0]);
	$stdout = stream_get_contents($pipes [1]);
	$stderr = stream_get_contents($pipes [2]);
	fclose($pipes [1]);
	fclose($pipes [2]);
	$exitCode = proc_close($process);

	return array(
		'exit' => (int)$exitCode,
		'stdout' => is_string($stdout) ? $stdout : '',
		'stderr' => is_string($stderr) ? $stderr : ''
	);
}

register_shutdown_function('sitemap_regression_remove_tree', $fixtureBase);

$results = array();
$failed = 0;

function sitemap_regression_assert($name, $ok, $details = '') {
	global $results, $failed;
	$results [] = array(
		'name' => $name,
		'status' => $ok ? 'PASS' : 'FAIL',
		'details' => (string)$details
	);
	if (!$ok) {
		$failed++;
	}
}

/**
 * Minimal well-formedness check for the fixed XML subset generated by
 * sitemap.php. This deliberately avoids requiring DOM/SimpleXML extensions,
 * which are not FlatPress runtime requirements.
 *
 * @param string $xml
 * @return bool
 */
function sitemap_regression_balanced_xml($xml) {
	if ($xml === '' || preg_match('//u', $xml) !== 1) {
		return false;
	}
	if (preg_match('/&(?!amp;|lt;|gt;|quot;|apos;|#\d+;|#x[0-9A-Fa-f]+;)/', $xml)) {
		return false;
	}

	$matches = array();
	if (!preg_match_all('/<([^>]+)>/', $xml, $matches)) {
		return false;
	}

	$stack = array();
	foreach ($matches [1] as $raw) {
		$tag = trim((string)$raw);
		if ($tag === '' || strpos($tag, '?') === 0 || strpos($tag, '!') === 0) {
			continue;
		}
		if (substr($tag, -1) === '/') {
			continue;
		}
		if ($tag [0] === '/') {
			$name = trim(substr($tag, 1));
			$open = array_pop($stack);
			if ($open !== $name) {
				return false;
			}
			continue;
		}

		$space = strpos($tag, ' ');
		$name = $space === false ? $tag : substr($tag, 0, $space);
		if ($name === '') {
			return false;
		}
		$stack [] = $name;
	}

	return empty($stack);
}

/**
 * Return the first <url> block whose decoded <loc> ends with a given suffix.
 *
 * @param array<int,string> $blocks
 * @param string $suffix
 * @return string
 */
function sitemap_regression_find_block($blocks, $suffix) {
	foreach ($blocks as $block) {
		if (preg_match('~<loc>(.*?)</loc>~s', $block, $match)) {
			$loc = html_entity_decode($match [1], ENT_QUOTES | ENT_XML1, 'UTF-8');
			if (substr($loc, -strlen($suffix)) === $suffix) {
				return $block;
			}
		}
	}
	return '';
}

/**
 * Return the decoded normal location from one <url> block.
 *
 * @param string $block
 * @return string
 */
function sitemap_regression_loc($block) {
	if (!preg_match('~<loc>(.*?)</loc>~s', $block, $match)) {
		return '';
	}
	return html_entity_decode($match [1], ENT_QUOTES | ENT_XML1, 'UTF-8');
}

/**
 * Return the decoded image location from one <url> block.
 *
 * @param string $block
 * @return string
 */
function sitemap_regression_image_loc($block) {
	if (!preg_match('~<image:loc>(.*?)</image:loc>~s', $block, $match)) {
		return '';
	}
	return html_entity_decode($match [1], ENT_QUOTES | ENT_XML1, 'UTF-8');
}

$copyOk = sitemap_regression_copy_source_tree(rtrim($sourceRoot, '/'), rtrim($fixtureRoot, '/'));
sitemap_regression_assert(
	'fixture_source_tree_copied_without_instance_content',
	$copyOk && !file_exists($fixtureRoot . 'fp-content'),
	$copyOk ? 'source fp-content excluded' : 'source copy failed'
);

$fixtureDirs = array(
	'fp-content/config',
	'fp-content/cache',
	'fp-content/compile',
	'fp-content/index',
	'fp-content/content',
	'fp-content/images',
	'fp-content/users',
	'fp-content/drafts'
);
$dirsOk = true;
foreach ($fixtureDirs as $dir) {
	$path = $fixtureRoot . $dir;
	if (!is_dir($path) && !mkdir($path, 0777, true) && !is_dir($path)) {
		$dirsOk = false;
		break;
	}
}
sitemap_regression_assert('fixture_runtime_directories_created', $dirsOk);

$settings = <<<'PHP'
<?php
$fp_config = array(
	'general' => array(
		'www' => 'https://example.test/flatpress/',
		'title' => 'Sitemap Regression',
		'subtitle' => '',
		'footer' => '',
