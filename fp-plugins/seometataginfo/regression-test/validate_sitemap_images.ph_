	),
	'locale' => array(
		'timeoffset' => 0,
		'timeformat' => '%H:%M:%S',
		'dateformat' => '%Y-%m-%d',
		'dateformatshort' => '%Y-%m-%d',
		'charset' => 'utf-8',
		'lang' => 'en-us'
	),
	'staticlist' => array(
		'naturalsort' => true
	),
	'plugins' => array(
		'bbcode' => array(
			'escape-html' => true,
			'comments' => true,
			'editor' => false,
			'url-maxlen' => 40,
			'maskattachs' => false
		),
		'prettyurls' => array(),
		'readmore' => array()
	),
	'auth' => array(
		'session_timeout' => 3600
	)
);
?>
PHP;

$plugins = <<<'PHP'
<?php
$fp_plugins = array(
	'bbcode',
	'gallerycaptions',
	'photoswipe',
	'prettyurls',
	'readmore',
	'thumb'
);
?>
PHP;

$widgets = <<<'PHP'
<?php
$fp_widgets = array(
	'top' => array(),
	'left' => array(),
	'right' => array(),
	'bottom' => array()
);
?>
PHP;

$configOk = sitemap_regression_write_file($fixtureRoot . 'fp-content/%%setup.lock', "setup\n")
	&& sitemap_regression_write_file($fixtureRoot . 'fp-content/config/settings.conf.php', $settings)
	&& sitemap_regression_write_file($fixtureRoot . 'fp-content/config/plugins.conf.php', $plugins)
	&& sitemap_regression_write_file($fixtureRoot . 'fp-content/config/widgets.conf.php', $widgets);
sitemap_regression_assert('fixture_configuration_created', $configOk);

$png = base64_decode('iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=', true);
$imagePaths = array(
	'fp-content/images/hidden-after-more.png',
	'fp-content/images/stream-original.png',
	'fp-content/images/scaled-original.png',
	'fp-content/images/.thumbs/scaled-original.png',
	'fp-content/images/gallery/a-first.png',
	'fp-content/images/gallery/b-second.png',
	'fp-content/images/static-gallery/a-static.png',
	'fp-content/images/static-gallery/b-static.png'
);
$imagesOk = is_string($png);
if ($imagesOk) {
	foreach ($imagePaths as $relative) {
		if (!sitemap_regression_write_file($fixtureRoot . $relative, $png)) {
			$imagesOk = false;
			break;
		}
	}
}
sitemap_regression_assert('fixture_images_created', $imagesOk, 'count=' . count($imagePaths));

$setupFile = $fixtureRoot . '_sitemap_fixture_setup.php';
$setupCode = <<<'PHP'
<?php
ini_set('session.save_path', sys_get_temp_dir());
$_SERVER ['REQUEST_METHOD'] = 'GET';
$_SERVER ['HTTP_HOST'] = 'example.test';
$_SERVER ['SERVER_NAME'] = 'example.test';

chdir(__DIR__);
require 'defaults.php';
require INCLUDES_DIR . 'includes.php';
system_init();

$entries = array(
	'entry260816-120000' => array(
		'subject' => 'Hidden after more',
		'content' => 'Visible text [more] [img=images/hidden-after-more.png]',
		'author' => 'Regression',
		'categories' => array()
	),
	'entry260816-110000' => array(
		'subject' => 'Stream image',
		'content' => '[img=images/stream-original.png scale=50%]',
		'author' => 'Regression',
		'categories' => array()
	),
	'entry260815-120000' => array(
		'subject' => 'Gallery entry',
		'content' => '[gallery=images/gallery]',
		'author' => 'Regression',
		'categories' => array()
	),
	'entry260814-120000' => array(
		'subject' => 'Scaled entry',
		'content' => '[img=images/scaled-original.png scale=50%]',
		'author' => 'Regression',
		'categories' => array()
	),
	'entry260813-120000' => array(
		'subject' => 'No image',
		'content' => 'Text only.',
		'author' => 'Regression',
		'categories' => array()
	)
);

foreach ($entries as $id => $entry) {
	$entry ['date'] = entry_idtotime($id);
	$result = entry_save($entry, $id);
	if ($result !== $id) {
		fwrite(STDERR, 'entry_save failed for ' . $id . ': ' . var_export($result, true) . "\n");
		exit(3);
	}
}

$static = array(
	'subject' => 'About',
	'content' => '[gallery=images/static-gallery]',
	'date' => strtotime('2026-08-12 12:00:00 UTC'),
	'author' => 'Regression'
);
if (!static_save($static, 'about')) {
	fwrite(STDERR, "static_save failed for about\n");
	exit(4);
}
?>
PHP;

$setupWritten = sitemap_regression_write_file($setupFile, $setupCode);
$setupRun = $setupWritten
	? sitemap_regression_run_php($setupFile, $fixtureRoot)
	: array('exit' => 2, 'stdout' => '', 'stderr' => 'fixture setup script could not be written');
@unlink($setupFile);

sitemap_regression_assert(
	'fixture_setup_exits_successfully',
	$setupRun ['exit'] === 0,
	'exit=' . $setupRun ['exit'] . '; stderr=' . trim($setupRun ['stderr'])
);
sitemap_regression_assert(
	'fixture_setup_has_no_stderr',
	trim($setupRun ['stderr']) === '',
	trim($setupRun ['stderr'])
);

$childFile = $fixtureRoot . '_sitemap_fixture_child.php';
$childCode = <<<'PHP'
<?php
ini_set('session.save_path', sys_get_temp_dir());
$root = rtrim(str_replace('\\', '/', $argv [1]), '/') . '/';
$_SERVER ['REQUEST_METHOD'] = 'GET';
$_SERVER ['HTTP_HOST'] = 'example.test';
$_SERVER ['SERVER_NAME'] = 'example.test';
if (!chdir($root)) {
	fwrite(STDERR, "Cannot switch to FlatPress fixture root.\n");
	exit(2);
}
require $root . 'sitemap.php';

echo "\n__FP_SITEMAP_RENDER_SAMPLE__\n";
echo sitemap_render_url(
	'https://example.test/?a=1&b=<x>',
	'2026-08-16T00:00:00+00:00',
	'https://cdn.example.test/image.png?x=1&y=2'
);
?>
PHP;

$childWritten = sitemap_regression_write_file($childFile, $childCode);
$childRun = $childWritten
	? sitemap_regression_run_php($childFile, $fixtureRoot, array(rtrim($fixtureRoot, '/')))
	: array('exit' => 2, 'stdout' => '', 'stderr' => 'sitemap child script could not be written');
@unlink($childFile);

$parts = explode("\n__FP_SITEMAP_RENDER_SAMPLE__\n", (string)$childRun ['stdout'], 2);
$xml = isset($parts [0]) ? trim($parts [0]) : '';
$sample = isset($parts [1]) ? trim($parts [1]) : '';

sitemap_regression_assert(
	'child_process_exits_successfully',
	$childRun ['exit'] === 0,
	'exit=' . $childRun ['exit'] . '; stderr=' . trim($childRun ['stderr'])
);
sitemap_regression_assert(
	'child_process_has_no_stderr',
	trim($childRun ['stderr']) === '',
	trim($childRun ['stderr'])
);
sitemap_regression_assert(
	'sitemap_is_balanced_utf8_xml_subset',
	sitemap_regression_balanced_xml($xml),
	substr($xml, 0, 300)
);
sitemap_regression_assert(
	'sitemap_protocol_09_default_namespace',
	strpos($xml, 'xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"') !== false
);
sitemap_regression_assert(
	'image_sitemap_namespace_11',
	strpos($xml, 'xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"') !== false
);
sitemap_regression_assert(
	'xml_declaration_is_utf8',
	strpos($xml, '<?xml version="1.0" encoding="UTF-8"?>') === 0
);
sitemap_regression_assert(
	'fixture_output_does_not_reference_installed_instance_assets',
	strpos($xml, 'Testgalerie') === false
		&& strpos($xml, 'avm-gelaende') === false
		&& strpos($xml, 'Leggero-Themepreview') === false
);
sitemap_regression_assert(
	'no_thumbnail_path_is_published',
	strpos($xml, '/.thumbs/') === false,
	'.thumbs occurrence=' . substr_count($xml, '/.thumbs/')
);

$urlMatches = array();
preg_match_all('~<url>\s*(.*?)</url>~s', $xml, $urlMatches);
$blocks = isset($urlMatches [0]) ? $urlMatches [0] : array();
sitemap_regression_assert('fixture_sitemap_contains_expected_url_count', count($blocks) === 7, 'count=' . count($blocks));

foreach ($blocks as $index => $block) {
	$locCount = preg_match_all('~<loc>.*?</loc>~s', $block, $unused);
	$imageCount = preg_match_all('~<image:image>.*?</image:image>~s', $block, $unused2);
	$imageLocCount = preg_match_all('~<image:loc>.*?</image:loc>~s', $block, $unused3);

	sitemap_regression_assert(
		'url_' . $index . '_has_exactly_one_loc',
		$locCount === 1,
		'loc_count=' . $locCount
	);
	sitemap_regression_assert(
		'url_' . $index . '_has_at_most_one_selected_image',
		$imageCount <= 1 && $imageLocCount === $imageCount,
		'image=' . $imageCount . '; image_loc=' . $imageLocCount
	);

	if ($imageLocCount === 1) {
		$imageLoc = sitemap_regression_image_loc($block);
		sitemap_regression_assert(
			'url_' . $index . '_image_loc_is_absolute_http_url',
			preg_match('~^https?://~i', $imageLoc) === 1,
			$imageLoc
		);
	}
}

$rootBlock = isset($blocks [0]) ? $blocks [0] : '';
sitemap_regression_assert(
	'frontpage_stream_skips_media_after_readmore_and_uses_next_original',
	sitemap_regression_image_loc($rootBlock) === 'https://example.test/flatpress/fp-content/images/stream-original.png',
	sitemap_regression_image_loc($rootBlock)
);

$block = sitemap_regression_find_block($blocks, '/2026/08/16/hidden-after-more/');
sitemap_regression_assert(
	'single_entry_ignores_readmore_and_uses_hidden_original',
	$block !== ''
		&& sitemap_regression_image_loc($block) === 'https://example.test/flatpress/fp-content/images/hidden-after-more.png',
	sitemap_regression_image_loc($block)
);

$block = sitemap_regression_find_block($blocks, '/2026/08/15/gallery-entry/');
sitemap_regression_assert(
	'entry_gallery_uses_first_sorted_fixture_original',
	$block !== ''
		&& sitemap_regression_image_loc($block) === 'https://example.test/flatpress/fp-content/images/gallery/a-first.png',
	sitemap_regression_image_loc($block)
);

$block = sitemap_regression_find_block($blocks, '/2026/08/14/scaled-entry/');
sitemap_regression_assert(
	'entry_scaled_image_uses_fixture_original_not_thumbnail',
	$block !== ''
		&& sitemap_regression_image_loc($block) === 'https://example.test/flatpress/fp-content/images/scaled-original.png',
	sitemap_regression_image_loc($block)
);

$block = sitemap_regression_find_block($blocks, '/2026/08/13/no-image/');
sitemap_regression_assert(
	'entry_without_image_has_no_image_extension_node',
	$block !== '' && strpos($block, '<image:image>') === false,
	$block
);

$block = sitemap_regression_find_block($blocks, '/about/');
sitemap_regression_assert(
	'static_page_uses_prettyurls_filtered_link',
	$block !== '' && sitemap_regression_loc($block) === 'https://example.test/flatpress/about/',
	sitemap_regression_loc($block)
);
sitemap_regression_assert(
	'static_gallery_uses_first_sorted_fixture_original',
	$block !== ''
		&& sitemap_regression_image_loc($block) === 'https://example.test/flatpress/fp-content/images/static-gallery/a-static.png',
	sitemap_regression_image_loc($block)
);

sitemap_regression_assert(
	'renderer_escapes_url_ampersand_and_angle_bracket',
	strpos($sample, '<loc>https://example.test/?a=1&amp;b=&lt;x&gt;</loc>') !== false,
	$sample
);
sitemap_regression_assert(
	'renderer_escapes_image_url_ampersand',
	strpos($sample, '<image:loc>https://cdn.example.test/image.png?x=1&amp;y=2</image:loc>') !== false,
	$sample
);
sitemap_regression_assert(
	'renderer_sample_is_balanced_xml_subset',
	sitemap_regression_balanced_xml($sample),
	$sample
);

$summary = array(
	'php_version' => PHP_VERSION,
	'fixture' => 'isolated temporary FlatPress installation; source fp-content excluded',
	'total' => count($results),
	'passed' => count($results) - $failed,
	'failed' => $failed,
	'results' => $results
);

echo json_encode($summary, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL;
exit(min(1, (int)$failed));
?>
